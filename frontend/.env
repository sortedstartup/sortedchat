VITE_API_URL=/hack
VITE_API_UPLOAD_URL=/hack

VITE_GOOGLE_CLIENT_ID="fake_client_id"
# This is a fake oAuth URL available only during dev time, controlled using go build flags
VITE_GOOGLE_OAUTH_URL="/hack/fakeoauth/oauth2/v2/auth"

# In dev mode we proxy all requests (backend+frontend) through the frontend server,
# this is needed for it to work on codespaces without
# Codespaces work well if we expose a single port and hosting everything (backend+frontend) there
# This has to be a full URL not just /hack, because OAuth provider will
VITE_GOOGLE_REDIRECT_URL="/hack/callback"
